# Server-only — never expose to the browser
PORT=4000

# Allowed browser origin(s) for credentialed CORS (comma-separated)
FRONTEND_ORIGIN=http://localhost:3000

# Pooled Neon (or VPS Postgres) connection string (application traffic)
DATABASE_URL=

# Direct connection string (Drizzle Kit migrations only)
DATABASE_URL_DIRECT=

# Better Auth
BETTER_AUTH_SECRET=
# Canonical public origin for auth cookies (Frontend origin when using same-site proxy)
BETTER_AUTH_URL=http://localhost:3000

# VPS disk media (Hostinger / local)
MEDIA_ROOT=./.data/media
# Public base URL for uploaded files (local example)
MEDIA_PUBLIC_BASE_URL=http://localhost:4000/media
# Production example:
# MEDIA_PUBLIC_BASE_URL=https://api.yourdomain.com/media

# Rate limits: memory (default, single VPS process) or redis (multi-process)
RATE_LIMIT_MODE=memory
# RATE_LIMIT_REDIS_URL=
