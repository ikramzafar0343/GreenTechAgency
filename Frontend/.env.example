# Node.js Backend base URL (server-only; used by public RSC reads and /api proxies)
BACKEND_URL=http://localhost:4000

# Optional browser origin (no secrets)
# NEXT_PUBLIC_APP_URL=http://localhost:3000

# Public base for VPS media previews in the browser (must match Backend MEDIA_PUBLIC_BASE_URL)
NEXT_PUBLIC_MEDIA_BASE_URL=http://localhost:4000/media
