# Node.js Backend base URL (server-only; used by public RSC reads and /api proxies)
BACKEND_URL=http://localhost:4000

# Official public site origin (sitemap, canonicals, OG, JSON-LD). Required in production.
NEXT_PUBLIC_SITE_URL=https://greentechagency.com

# Optional browser origin for auth/cookies (usually same as SITE_URL)
NEXT_PUBLIC_APP_URL=https://greentechagency.com

# Public base for VPS media previews in the browser (must match Backend MEDIA_PUBLIC_BASE_URL)
NEXT_PUBLIC_MEDIA_BASE_URL=http://localhost:4000/media
